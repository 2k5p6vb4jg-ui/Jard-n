{
  "name": "ortopedia-gestion",
  "version": "0.1.0",
  "private": true,
  "description": "Gestión clínica y de taller para ortopedia. Web App local (LAN), SQLite + Prisma.",
  "scripts": {
    "dev": "node scripts/lan-info.mjs && next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "node scripts/lan-info.mjs && next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "prisma migrate dev --name init && prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
