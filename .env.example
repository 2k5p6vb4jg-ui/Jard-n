# Ruta relativa a prisma/schema.prisma → crea prisma/dev.db
DATABASE_URL="file:./dev.db"

# Carpeta raíz de adjuntos clínicos (estudios de pisada, huellas, recetas)
UPLOADS_DIR="./uploads"

# Carpeta de las copias de seguridad automáticas (mejor en un disco externo o NAS), p. ej.:
#   Windows: BACKUP_DIR="D:\\CopiasJardon"     macOS: BACKUP_DIR="/Volumes/Copias/Jardon"
BACKUP_DIR="./backups"
