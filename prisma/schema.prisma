// ============================================================================
//  Jardón Ortopedia · Gestión clínica y de taller
//  Base de datos local SQLite (prisma/dev.db) — los datos nunca salen del equipo.
//
//  Convenciones:
//   - Importes monetarios en CÉNTIMOS (Int) para evitar errores de redondeo.
//   - Medidas corporales en centímetros (Float); medidas del pie en milímetros.
//   - Enumerados en inglés; las etiquetas en castellano viven en src/lib/labels.ts
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
//  ENUMERADOS
// ----------------------------------------------------------------------------

enum Side {
  LEFT
  RIGHT
  BOTH
}

/// Estado de una prescripción clínica (plantilla o media).
enum PrescriptionStatus {
  PENDING // Tomadas medidas, pendiente de fabricar / pedir
  IN_PRODUCTION // En fabricación (plantillas) o pedida a proveedor (medias)
  READY // Lista para probar / entregar
  DELIVERED // Entregada al paciente → empieza a contar la renovación
  CANCELLED
}

/// Seguimiento del aviso de renovación (6 meses medias / 12 meses plantillas).
enum RenewalStatus {
  PENDING // Aún no se ha gestionado
  CONTACTED // Se ha llamado / avisado al paciente
  RENEWED // Se ha hecho una nueva prescripción
  DISMISSED // El paciente no renueva
}

enum FootPathology {
  FLAT_FOOT // Pie plano
  CAVUS_FOOT // Pie cavo
  PLANTAR_FASCIITIS // Fascitis plantar
  HEEL_SPUR // Espolón calcáneo
  METATARSALGIA
  HALLUX_VALGUS // Juanete
  MORTON_NEUROMA // Neuroma de Morton
  PRONATION // Pie pronador
  SUPINATION // Pie supinador
  LEG_LENGTH_DISCREPANCY // Dismetría
  DIABETIC_FOOT // Pie diabético
  OTHER
}

enum InsoleMaterial {
  EVA
  POLYPROPYLENE // Polipropileno
  RESIN // Resina
  CORK // Corcho
  CARBON_FIBER
  PORON
  LEATHER // Piel / forro
  OTHER
}

enum InsoleFinish {
  MICROPERFORATED // Microperforado
  OPEN_CELL // Celdas abiertas
  CLOSED_CELL // Celdas cerradas
  LEATHER_LINED // Forrado en piel
  TEXTILE_LINED // Forrado textil
  NONE
}

enum InsoleType {
  SPORT // Deportiva
  DAILY // Calle / uso diario
  DRESS // Vestir (fina)
  DIABETIC // Descarga diabética
  CHILD // Infantil
}

enum CorrectionType {
  MEDIAL_WEDGE // Cuña pronadora/supinadora interna
  LATERAL_WEDGE
  ARCH_SUPPORT // Soporte arco longitudinal interno
  RETROCAPITAL_BAR // Barra retrocapital
  METATARSAL_PAD // Oliva / almohadilla metatarsal
  HEEL_CUP // Taloneta / copa de talón
  HEEL_LIFT // Alza de talón
  HEEL_SPUR_RELIEF // Descarga de espolón
  FOREFOOT_RELIEF // Descarga antepié
  OTHER
}

enum CompressionClass {
  CCL1 // 18–21 mmHg
  CCL2 // 23–32 mmHg
  CCL3 // 34–46 mmHg
  CCL4 // > 49 mmHg
}

enum GarmentType {
  KNEE_HIGH // Media corta (A-D)
  THIGH_HIGH // Media a muslo (A-G)
  THIGH_HIGH_SILICONE // Media a muslo con blonda de silicona
  PANTYHOSE // Panty (A-T)
  MATERNITY_PANTYHOSE // Panty premamá
  ARM_SLEEVE // Manguito (linfedema)
  OTHER
}

enum KnitType {
  CIRCULAR // Tejido circular (serie / medida)
  FLAT // Tejido plano (linfedema, medida)
}

enum DocumentType {
  GAIT_STUDY // Estudio digital de la pisada
  FOOTPRINT_PHOTO // Foto de huella física (pedigrafía)
  PRESCRIPTION // Receta médica / Seguridad Social
  MEDICAL_REPORT // Informe médico
  CONSENT // Consentimiento informado / RGPD
  PHOTO // Foto clínica general
  OTHER
}

enum DocumentSource {
  UPLOAD // Archivo subido
  CAMERA // Capturado con la cámara del móvil/tablet
}

/// Flujo de la orden de trabajo:
/// RECEIVED ➔ DIAGNOSIS ➔ QUOTED ➔ IN_REPAIR ➔ READY ➔ DELIVERED (CANCELLED si se rechaza)
enum WorkOrderStatus {
  RECEIVED // Entrada
  DIAGNOSIS // Diagnóstico
  QUOTED // Presupuestado
  IN_REPAIR // En reparación
  READY // Listo para entregar
  DELIVERED // Entregado
  CANCELLED // Anulado / presupuesto rechazado
}

enum LaborMode {
  HOURLY // Tarifa por hora × horas registradas
  FIXED // Mano de obra a precio cerrado
}

enum QuoteStatus {
  DRAFT // Borrador
  SENT // Entregado al cliente
  ACCEPTED // Aceptado
  REJECTED // Rechazado
  EXPIRED // Caducado
}

enum InterventionType {
  DELIVERY // Entrega inicial al paciente
  INSPECTION // Revisión
  REPAIR // Reparación
  MAINTENANCE // Mantenimiento
  ADJUSTMENT // Ajuste
  WARRANTY_CLAIM // Reclamación en garantía
  RETURN // Devolución / retirada
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  BACKUP
}

// ----------------------------------------------------------------------------
//  CONFIGURACIÓN DEL NEGOCIO (fila única id = 1)
// ----------------------------------------------------------------------------

model Settings {
  id                     Int       @id @default(1)
  businessName           String
  legalName              String?
  taxId                  String? // CIF / NIF
  healthLicense          String? // Nº de licencia sanitaria de establecimiento
  address                String?
  city                   String?
  postalCode             String?
  province               String?
  phone                  String?
  email                  String?
  website                String?
  /// Identidad visual (editable en Ajustes): color principal, acento y tono oscuro de la barra lateral
  brandColor             String    @default("#1E5A46")
  accentColor            String    @default("#C5A059")
  darkColor              String    @default("#25282B")
  logoPath               String?
  defaultHourlyRateCents Int       @default(3500)
  defaultTaxRate         Float     @default(21) // IVA %
  quoteValidityDays      Int       @default(30)
  quoteLegalFooter       String? // Pie legal de presupuestos (RGPD, condiciones…)
  insoleRenewalMonths    Int       @default(12)
  stockingRenewalMonths  Int       @default(6)
  renewalWarningDays     Int       @default(30) // Avisar X días antes de vencer
  // Acceso con PIN (opcional). Sin PIN, la app queda abierta a toda la red local.
  pinHash                String? // scrypt$sal$hash
  sessionSecret          String? // Firma de las cookies de sesión
  sessionHours           Int       @default(12) // Horas hasta pedir de nuevo el PIN
  sessionVersion         Int       @default(0) // Al cambiar el PIN se cierran todas las sesiones
  // Copias automáticas
  autoBackup             Boolean   @default(true)
  autoBackupKeep         Int       @default(14) // Nº de copias diarias que se conservan
  lastAutoBackupAt       DateTime?
  /// Segunda copia: carpeta en un disco externo, pendrive o NAS donde se duplica cada copia
  backupMirrorDir        String?
  lastMirrorAt           DateTime?
  lastMirrorError        String?
  updatedAt              DateTime  @updatedAt
}

// ----------------------------------------------------------------------------
//  MÓDULO 1 · CRM E HISTORIAL CLÍNICO
// ----------------------------------------------------------------------------

model Patient {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  dni            String?   @unique // DNI / NIE
  birthDate      DateTime?
  phone          String?
  phoneAlt       String?
  email          String?
  address        String?
  city           String?
  postalCode     String?
  healthCardNo   String? // Nº tarjeta sanitaria (SIP / TSI)
  notes          String? // Observaciones generales
  // RGPD
  gdprConsent    Boolean   @default(false)
  gdprConsentAt  DateTime?
  marketingOptIn Boolean   @default(false)
  archivedAt     DateTime? // Baja lógica (derecho de supresión se ejecuta con borrado real)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insoles      InsolePrescription[]
  stockings    CompressionStocking[]
  documents    ClinicalDocument[]
  workOrders   WorkOrder[]
  products     TrackedProduct[]
  insoleOrders InsoleOrder[]
  /// Residencia o centro de día al que acude (opcional)
  centerId     String?
  center       Center?               @relation(fields: [centerId], references: [id], onDelete: SetNull)

  @@index([lastName, firstName])
  @@index([centerId])
  @@index([phone])
}

/// Especialidad 1 · Plantillas a medida
model InsolePrescription {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  insoleType InsoleType @default(DAILY)
  side       Side       @default(BOTH)

  // Diagnóstico
  pathologies    InsolePathology[]
  diagnosisNotes String?
  prescribedBy   String? // Podólogo / traumatólogo que deriva

  // Material
  material     InsoleMaterial  @default(EVA)
  shoreDensity Int? // Densidad EVA en grados Shore A (p. ej. 35, 45, 55)
  baseMaterial InsoleMaterial?
  baseDensity  Int?
  finish       InsoleFinish    @default(NONE)
  thicknessMm  Float?

  // Medidas (mm salvo talla)
  shoeSize          Float? // Talla europea
  footLengthLeftMm  Float?
  footLengthRightMm Float?
  footWidthLeftMm   Float?
  footWidthRightMm  Float?
  archHeightLeftMm  Float?
  archHeightRightMm Float?
  heelLiftMm        Float? // Alza compensación dismetría

  // Corrección
  corrections    InsoleCorrection[]
  technicalNotes String?

  // Ciclo de vida
  status              PrescriptionStatus @default(PENDING)
  priceCents          Int?
  measuredAt          DateTime           @default(now())
  deliveredAt         DateTime?
  /// deliveredAt + Settings.insoleRenewalMonths (12 meses). Indexado para el panel.
  nextReviewAt        DateTime?
  renewalStatus       RenewalStatus      @default(PENDING)
  renewalNote         String?
  /// Última gestión del aviso (llamada, descarte, aplazamiento)
  renewalUpdatedAt    DateTime?
  /// "Recordar más tarde": el aviso no se muestra hasta esta fecha
  renewalSnoozedUntil DateTime?

  documents ClinicalDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([nextReviewAt, renewalStatus])
}

model InsolePathology {
  id        String             @id @default(cuid())
  insoleId  String
  insole    InsolePrescription @relation(fields: [insoleId], references: [id], onDelete: Cascade)
  pathology FootPathology
  side      Side               @default(BOTH)
  notes     String?

  @@unique([insoleId, pathology, side])
}

model InsoleCorrection {
  id       String             @id @default(cuid())
  insoleId String
  insole   InsolePrescription @relation(fields: [insoleId], references: [id], onDelete: Cascade)
  type     CorrectionType
  side     Side               @default(BOTH)
  valueMm  Float? // Altura / grosor del elemento
  notes    String?

  @@index([insoleId])
}

/// Especialidad 2 · Medias de compresión.
/// Puntos de medida estándar RAL-GZ 387: perímetros cB…cT y longitudes lA-x.
model CompressionStocking {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  compressionClass CompressionClass
  garmentType      GarmentType
  knitType         KnitType         @default(CIRCULAR)
  side             Side             @default(BOTH)
  madeToMeasure    Boolean          @default(false)
  brand            String?
  model            String?
  color            String?
  openToe          Boolean          @default(false) // Puntera abierta
  diagnosis        String? // Insuficiencia venosa, linfedema, post-quirúrgico…

  // Perímetros (cm)
  cB  Float? // Tobillo
  cB1 Float? // Transición tobillo-gemelo
  cC  Float? // Gemelo (máx.)
  cD  Float? // Bajo rodilla
  cE  Float? // Rodilla
  cF  Float? // Mitad muslo
  cG  Float? // Ingle / raíz muslo
  cH  Float? // Cadera (panty)
  cT  Float? // Cintura (panty)
  cY  Float? // Talón en diagonal

  // Longitudes desde el suelo (cm)
  lAB1 Float?
  lAC  Float?
  lAD  Float?
  lAE  Float?
  lAF  Float?
  lAG  Float?
  lAT  Float?

  footLengthCm     Float?
  measurementNotes String?

  // Prescripción médica / Seguridad Social
  prescribingDoctor   String?
  doctorLicenseNo     String? // Nº colegiado
  prescriptionNumber  String? // Nº de receta / orden de dispensación
  prescriptionDate    DateTime?
  isPublicHealth      Boolean   @default(false) // Financiado por Seguridad Social
  publicHealthCode    String? // Código de producto en catálogo ortoprotésico
  patientContribCents Int? // Aportación del usuario

  // Ciclo de vida
  status              PrescriptionStatus @default(PENDING)
  priceCents          Int?
  measuredAt          DateTime           @default(now())
  deliveredAt         DateTime?
  /// deliveredAt + Settings.stockingRenewalMonths (6 meses).
  nextReviewAt        DateTime?
  renewalStatus       RenewalStatus      @default(PENDING)
  renewalNote         String?
  /// Última gestión del aviso (llamada, descarte, aplazamiento)
  renewalUpdatedAt    DateTime?
  /// "Recordar más tarde": el aviso no se muestra hasta esta fecha
  renewalSnoozedUntil DateTime?

  documents ClinicalDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([nextReviewAt, renewalStatus])
}

/// Estudios de pisada, fotos de huellas, recetas… guardados en /uploads/<patientId>/
model ClinicalDocument {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Vínculo opcional a la prescripción a la que pertenece
  insoleId   String?
  insole     InsolePrescription?  @relation(fields: [insoleId], references: [id], onDelete: SetNull)
  stockingId String?
  stocking   CompressionStocking? @relation(fields: [stockingId], references: [id], onDelete: SetNull)

  type         DocumentType
  source       DocumentSource @default(UPLOAD)
  title        String
  description  String?
  originalName String
  /// Ruta relativa dentro de UPLOADS_DIR, p. ej. "clxyz123/2026-10-06_estudio-pisada.pdf"
  storagePath  String         @unique
  mimeType     String
  sizeBytes    Int
  sha256       String? // Integridad del archivo
  takenAt      DateTime? // Fecha del estudio / foto

  createdAt DateTime @default(now())

  @@index([patientId, type])
}

// ----------------------------------------------------------------------------
//  MÓDULO 2 · TALLER, REPARACIONES Y COSTES
// ----------------------------------------------------------------------------

model Technician {
  id              String  @id @default(cuid())
  name            String
  hourlyRateCents Int? // Si es null se usa Settings.defaultHourlyRateCents
  active          Boolean @default(true)
  pin             String? // PIN corto opcional para fichar desde la tablet

  workOrders    WorkOrder[]
  timeEntries   TimeEntry[]
  interventions ProductIntervention[]

  createdAt DateTime @default(now())
}

model WorkOrder {
  id   String @id @default(cuid())
  /// Código legible: OT-2026-0001
  code String @unique

  patientId     String?
  patient       Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  // Cliente no paciente (residencia, mutua, particular sin ficha clínica)
  customerName  String?
  customerPhone String?
  // Centro relacionado (B2B)
  centerId      String?
  center        Center?     @relation(fields: [centerId], references: [id], onDelete: SetNull)
  centerLink    CenterLink?

  // Equipo
  productId           String?
  product             TrackedProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  equipmentCategoryId String
  equipmentCategory   CatalogOption   @relation("WorkOrderEquipment", fields: [equipmentCategoryId], references: [id], onDelete: Restrict)
  equipmentBrand      String?
  equipmentModel      String?
  serialNumber        String? // Copia libre si el equipo no está en trazabilidad
  accessories         String? // Cargador, cojín, reposapiés…

  serviceTypeId String
  serviceType   CatalogOption   @relation("WorkOrderService", fields: [serviceTypeId], references: [id], onDelete: Restrict)
  status        WorkOrderStatus @default(RECEIVED)
  priorityId    String
  priority      CatalogOption   @relation("WorkOrderPriority", fields: [priorityId], references: [id], onDelete: Restrict)
  underWarranty Boolean         @default(false)

  reportedIssue String // Avería según el cliente
  diagnosis     String? // Diagnóstico técnico
  workDone      String? // Trabajo realizado
  internalNotes String?

  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  // Mano de obra
  laborMode       LaborMode @default(HOURLY)
  laborRateCents  Int? // Tarifa/hora aplicada (snapshot)
  laborFixedCents Int? // Si laborMode = FIXED
  discountPercent Float     @default(0)
  taxRate         Float     @default(21)

  // Fechas
  receivedAt  DateTime  @default(now())
  promisedAt  DateTime? // Fecha comprometida
  completedAt DateTime?
  deliveredAt DateTime?

  parts         WorkOrderPart[]
  timeEntries   TimeEntry[]
  statusHistory WorkOrderStatusChange[]
  quotes        Quote[]
  interventions ProductIntervention[]

  maintenanceVisit MaintenanceVisit?

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos    Photo[]

  @@index([status])
  @@index([patientId])
  @@index([productId])
  @@index([centerId])
}

/// Piezas y materiales consumidos en la orden.
model WorkOrderPart {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  categoryId     String
  category       CatalogOption @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reference      String? // Ref. proveedor
  description    String
  quantity       Float         @default(1)
  unit           String        @default("ud") // ud, m, m², kg, l
  unitCostCents  Int           @default(0) // Coste de compra (margen interno)
  unitPriceCents Int // Precio de venta al cliente

  createdAt DateTime @default(now())

  @@index([workOrderId])
}

/// Registro de tiempo del técnico (mano de obra por horas).
model TimeEntry {
  id           String      @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  startedAt   DateTime
  endedAt     DateTime? // null = cronómetro en marcha
  minutes     Int? // Calculado al cerrar o introducido a mano
  description String?

  @@index([workOrderId])
}

model WorkOrderStatusChange {
  id          String           @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  note        String?
  changedAt   DateTime         @default(now())

  @@index([workOrderId, changedAt])
}

/// Presupuesto formal (PDF). Guarda una instantánea de importes por si cambia la OT.
model Quote {
  id          String      @id @default(cuid())
  /// PRES-2026-0001
  number      String      @unique
  workOrderId String
  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  status      QuoteStatus @default(DRAFT)

  issuedAt   DateTime @default(now())
  validUntil DateTime

  partsCents    Int
  laborCents    Int
  discountCents Int   @default(0)
  subtotalCents Int // Base imponible
  taxRate       Float
  taxCents      Int
  totalCents    Int

  notes      String?
  /// Líneas congeladas en JSON (piezas + mano de obra) para reimprimir idéntico.
  linesJson  String
  pdfPath    String? // Copia del PDF en uploads/quotes/
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([workOrderId])
}

// ----------------------------------------------------------------------------
//  MÓDULO 2b · TALLER DE PLANTILLAS (pedidos de fabricación, entrega y cobro)
// ----------------------------------------------------------------------------

/// Listas de opciones editables desde Ajustes → Opciones.
enum OptionKind {
  // Plantillas
  TYPE
  MATERIAL
  STATUS
  // Reparaciones
  EQUIPMENT_CATEGORY
  SERVICE_TYPE
  PART_CATEGORY
  PRIORITY
  WORK_STATUS
  // Centros
  CENTER_TYPE
  CENTER_STATUS
}

/// Relación de un pedido (reparación o plantillas) con un centro.
enum CenterLink {
  ORDERED // Pedido directo del centro (compra para el centro)
  REFERRED // Derivado por el centro (el cliente viene por recomendación suya)
  RESIDENT // El cliente es usuario/residente del centro
}

/// Opciones editables desde Ajustes → Opciones (Reparaciones y Plantillas).
/// Una opción en uso no se borra: se desactiva y deja de ofrecerse en los formularios nuevos.
/// `key` identifica las opciones con significado propio para la app (p. ej. prioridad NORMAL,
/// servicio WARRANTY, estados de reparación); las añadidas por el usuario no tienen.
model CatalogOption {
  id        String     @id @default(cuid())
  kind      OptionKind
  key       String?
  label     String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  /// Solo estados de plantillas: el pedido está terminado (entregado, anulado…) y sale de «En curso»
  isFinal   Boolean    @default(false)

  typeOrders     InsoleOrder[] @relation("InsoleOrderType")
  materialOrders InsoleOrder[] @relation("InsoleOrderMaterial")
  statusOrders   InsoleOrder[] @relation("InsoleOrderStatus")

  equipmentOrders WorkOrder[]      @relation("WorkOrderEquipment")
  serviceOrders   WorkOrder[]      @relation("WorkOrderService")
  priorityOrders  WorkOrder[]      @relation("WorkOrderPriority")
  parts           WorkOrderPart[]
  products        TrackedProduct[]
  centerTypes     Center[]         @relation("CenterType")
  centerStatuses  Center[]         @relation("CenterStatus")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, label])
  @@unique([kind, key])
  @@index([kind, sortOrder])
  @@map("InsoleOrderOption")
}

model InsoleOrder {
  id   String @id @default(cuid())
  /// Código legible: PL-2026-0001
  code String @unique

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  centerId   String?
  center     Center?     @relation(fields: [centerId], references: [id], onDelete: SetNull)
  centerLink CenterLink?

  typeId     String
  type       CatalogOption  @relation("InsoleOrderType", fields: [typeId], references: [id], onDelete: Restrict)
  side       Side           @default(BOTH)
  shoeSize   Float? // Número de pie (talla europea)
  materialId String?
  material   CatalogOption? @relation("InsoleOrderMaterial", fields: [materialId], references: [id], onDelete: Restrict)
  statusId   String
  status     CatalogOption  @relation("InsoleOrderStatus", fields: [statusId], references: [id], onDelete: Restrict)

  measuredAt DateTime? // Toma de medidas
  dueAt      DateTime? // Entrega prevista
  priceCents Int?
  paid       Boolean   @default(false)
  notes      String?

  photos Photo[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([centerId])
  @@index([statusId])
}

/// Fotos de una reparación o de unas plantillas (reducidas en el dispositivo a ~1600 px).
/// Archivos en uploads/fotos/<reparaciones|plantillas>/<id>/; al borrar el registro se borran las fotos.
model Photo {
  id            String       @id @default(cuid())
  workOrderId   String?
  workOrder     WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  insoleOrderId String?
  insoleOrder   InsoleOrder? @relation(fields: [insoleOrderId], references: [id], onDelete: Cascade)
  storagePath   String       @unique
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime     @default(now())

  @@index([workOrderId])
  @@index([insoleOrderId])
}

// ----------------------------------------------------------------------------
//  MÓDULO 2c · CENTROS (B2B: residencias, centros de día…)
// ----------------------------------------------------------------------------

model Center {
  id         String        @id @default(cuid())
  name       String
  typeId     String
  type       CatalogOption @relation("CenterType", fields: [typeId], references: [id], onDelete: Restrict)
  statusId   String
  status     CatalogOption @relation("CenterStatus", fields: [statusId], references: [id], onDelete: Restrict)
  taxId      String? // CIF
  address    String?
  postalCode String?
  city       String?
  phone      String?
  email      String?
  places     Int? // Nº de plazas
  conditions String? // Descuento pactado, forma de pago…
  notes      String?

  contacts     CenterContact[]
  proposals    CenterProposal[]
  patients     Patient[]
  workOrders   WorkOrder[]
  insoleOrders InsoleOrder[]
  products     TrackedProduct[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

enum ProposalKind {
  SALE_PACK // Pack de venta (p. ej. 3 sillas + cojines)
  MAINTENANCE // Contrato de mantenimiento (revisiones periódicas)
  REPAIR_PLAN // Contrato de reparaciones (bolsa de horas, cuota…)
  OTHER
}

enum BillingPeriod {
  ONE_OFF // Pago único
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Propuesta comercial a un centro (pack o contrato), con PDF. Los importes quedan congelados al guardarla.
model CenterProposal {
  id              String             @id @default(cuid())
  /// PROP-2026-0001
  number          String             @unique
  centerId        String
  center          Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  kind            ProposalKind
  title           String
  intro           String? // Texto para el centro
  /// Líneas [{ description, quantity, unit, unitPriceCents }]
  linesJson       String
  discountPercent Float              @default(0)
  taxRate         Float              @default(21)
  subtotalCents   Int // Base imponible (tras descuento)
  taxCents        Int
  totalCents      Int // Importe por periodo (o total si es pago único)
  billingPeriod   BillingPeriod      @default(ONE_OFF)
  durationMonths  Int? // Duración del contrato
  visitsPerYear   Int? // Revisiones al año (mantenimiento)
  status          QuoteStatus        @default(DRAFT)
  issuedAt        DateTime           @default(now())
  validUntil      DateTime
  decidedAt       DateTime? // Fecha de aceptación o rechazo
  internalNotes   String?
  /// Equipos incluidos (contratos de mantenimiento)
  products        TrackedProduct[]
  /// Calendario de revisiones (contratos de mantenimiento aceptados)
  visits          MaintenanceVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId])
}

/// Revisión programada de un contrato de mantenimiento. Al crear su orden queda enlazada a ella.
model MaintenanceVisit {
  id          String         @id @default(cuid())
  proposalId  String
  proposal    CenterProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  dueAt       DateTime
  workOrderId String?        @unique
  workOrder   WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([proposalId])
  @@index([dueAt])
}

/// Persona de contacto en un centro (dirección, compras, enfermería…)
model CenterContact {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name     String
  role     String?
  phone    String?
  email    String?

  createdAt DateTime @default(now())

  @@index([centerId])
}

// ----------------------------------------------------------------------------
//  MÓDULO 2d · PEDIDOS A MARCAS (qué hay que pedir, cuándo y para quién)
// ----------------------------------------------------------------------------

/// Marca o fabricante al que se hacen los pedidos (Orliman, DJO, Prim, Sunrise…)
model Supplier {
  id           String  @id @default(cuid())
  name         String  @unique
  contactName  String? // Comercial
  phone        String?
  email        String?
  website      String? // Web o portal de pedidos
  customerNo   String? // Nuestro nº de cliente con ellos
  leadTimeDays Int? // Plazo habitual de entrega
  notes        String?
  active       Boolean @default(true)

  items  OrderItem[]
  orders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderItemStatus {
  PENDING // Por pedir
  ORDERED // Pedido, en camino
  RECEIVED // Recibido en la tienda
  DELIVERED // Entregado / colocado a quien lo necesitaba
  CANCELLED
}

/// Artículo que hay que pedir (o ya pedido). «Para quién»: cliente, centro, reparación, plantillas o stock (ninguno).
model OrderItem {
  id          String          @id @default(cuid())
  description String
  reference   String?
  quantity    Float           @default(1)
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status      OrderItemStatus @default(PENDING)
  neededBy    DateTime? // Para cuándo hace falta
  notes       String?

  patientId       String?
  patient         Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  centerId        String?
  center          Center?        @relation(fields: [centerId], references: [id], onDelete: SetNull)
  workOrderId     String?
  workOrder       WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  insoleOrderId   String?
  insoleOrder     InsoleOrder?   @relation(fields: [insoleOrderId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  orderedAt   DateTime?
  receivedAt  DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([workOrderId])
  @@index([patientId])
}

/// Pedido hecho a una marca: agrupa los artículos pedidos a la vez. Su estado sale de los de sus artículos.
model PurchaseOrder {
  id          String    @id @default(cuid())
  /// PED-2026-0001
  number      String    @unique
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderedAt   DateTime  @default(now())
  via         String? // Web, email, teléfono, comercial…
  supplierRef String? // Nº de pedido de la marca
  expectedAt  DateTime? // Llegada prevista
  notes       String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
}

// ----------------------------------------------------------------------------
//  MÓDULO 3 · TRAZABILIDAD DE PRODUCTOS DE ALTO VALOR
// ----------------------------------------------------------------------------

model TrackedProduct {
  id             String        @id @default(cuid())
  serialNumber   String        @unique // Obligatorio
  lotNumber      String? // Lote de fabricación
  categoryId     String
  category       CatalogOption @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          String
  model          String
  description    String?
  udi            String? // Identificador único de dispositivo (MDR)
  supplier       String?
  manufacturedAt DateTime?

  /// Equipo propiedad de un centro (en lugar de un paciente)
  centerId String?
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  purchasePriceCents Int?
  salePriceCents     Int?
  isPublicHealth     Boolean @default(false)

  deliveredAt    DateTime?
  warrantyMonths Int       @default(24)
  /// deliveredAt + warrantyMonths
  warrantyUntil  DateTime?
  nextServiceAt  DateTime? // Próximo mantenimiento preventivo
  notes          String?

  interventions ProductIntervention[]
  workOrders    WorkOrder[]

  proposals CenterProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([warrantyUntil])
}

/// Histórico de intervenciones ligado al número de serie.
model ProductIntervention {
  id            String           @id @default(cuid())
  productId     String
  product       TrackedProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          InterventionType
  date          DateTime         @default(now())
  description   String
  underWarranty Boolean          @default(false)

  workOrderId  String?
  workOrder    WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, date])
}

// ----------------------------------------------------------------------------
//  MÓDULO 4 · AUDITORÍA (RGPD) Y COPIAS DE SEGURIDAD
// ----------------------------------------------------------------------------

/// Registro de accesos/cambios a datos de salud (art. 32 RGPD — trazabilidad).
model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String // "Patient", "ClinicalDocument", "Backup"…
  entityId  String?
  summary   String?
  ip        String? // IP del dispositivo de la red local
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model BackupRecord {
  id        String   @id @default(cuid())
  fileName  String
  sizeBytes Int
  createdAt DateTime @default(now())
}
